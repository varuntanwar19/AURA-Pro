# ============================================================
# AURA - Autonomous Unified Resource Abstraction
# Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─────────────────────────────────────────────
# Ollama LLM Configuration
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────
# ChromaDB Vector Store
# ─────────────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ─────────────────────────────────────────────
# Monitoring & Observability
# ─────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=aura-*

# ─────────────────────────────────────────────
# Kubernetes
# ─────────────────────────────────────────────
# Path to kubeconfig file (leave empty to use in-cluster config)
KUBERNETES_CONFIG_PATH=
KUBERNETES_MCP_URL=

# ─────────────────────────────────────────────
# GitHub Integration
# ─────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo
GITHUB_MCP_URL=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Azure Cloud (optional for POC)
# ─────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_LOCATION=East US
AZURE_RESOURCE_GROUP_NAME=aura-poc-rg
AZURE_CLUSTER_NAME=aura-aks-poc
AZURE_NODE_VM_SIZE=Standard_B2s

# ─────────────────────────────────────────────
# AWS Cloud (optional for POC)
# ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─────────────────────────────────────────────
# GCP Cloud (optional for POC)
# ─────────────────────────────────────────────
GCP_PROJECT_ID=
# Path to GCP service account JSON credentials file
GCP_CREDENTIALS_PATH=

# ─────────────────────────────────────────────
# Microsoft 365 / Teams Integration
# ─────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
SHAREPOINT_SITE_URL=

# ─────────────────────────────────────────────
# Backend Server
# ─────────────────────────────────────────────
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# Frontend (Vite)
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
